                   }
               }

               stage('Publish Artifacts') {
                   steps {
                       dir('project/app') {
                            script {
                               bat 'copy /Y "target\\app-1.0-SNAPSHOT-jar-with-dependencies.jar" "D:\\copy\\"'
                           }
